<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>MoonlightPeaks.GameBridge</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ManagedDir>$(GameDir)/Moonlight Peaks.app/Contents/Resources/Data/Managed</ManagedDir>
    <CoreDir>$(GameDir)/BepInEx/core</CoreDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="0Harmony"><HintPath>$(CoreDir)/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Chicken.UI"><HintPath>$(ManagedDir)/littlechickengamecompany.chicken-ui.runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(CoreDir)/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule"><HintPath>$(ManagedDir)/UnityEngine.ScreenCaptureModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(ManagedDir)/UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(ManagedDir)/Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Vampire.Runtime"><HintPath>$(ManagedDir)/Vampire.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Chicken.Utilities"><HintPath>$(ManagedDir)/littlechickengamecompany.chicken-utilities.runtime.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CopyToPlugins" AfterTargets="Build">
    <MakeDir Directories="$(GameDir)/BepInEx/plugins/MoonlightPeaks.GameBridge" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)/BepInEx/plugins/MoonlightPeaks.GameBridge" />
  </Target>
</Project>
