<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>MoonlightPeaks.SkipIntro</AssemblyName>
    <RootNamespace>MoonlightPeaks.SkipIntro</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GameManagedDir>$(GameDir)/Moonlight Peaks.app/Contents/Resources/Data/Managed</GameManagedDir>
    <BepInExCoreDir>$(GameDir)/BepInEx/core</BepInExCoreDir>
    <PluginsDir>$(GameDir)/BepInEx/plugins</PluginsDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx & Harmony -->
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Unity -->
    <Reference Include="UnityEngine">
      <HintPath>$(GameManagedDir)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameManagedDir)/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameManagedDir)/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameManagedDir)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Rewired_Core"><HintPath>$(GameManagedDir)/Rewired_Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(GameManagedDir)/UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <!-- Game Assemblies -->
    <Reference Include="Vampire.Runtime">
      <HintPath>$(GameManagedDir)/Vampire.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="littlechickengamecompany.chicken-ui.runtime">
      <HintPath>$(GameManagedDir)/littlechickengamecompany.chicken-ui.runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="littlechickengamecompany.chicken-utilities.runtime">
      <HintPath>$(GameManagedDir)/littlechickengamecompany.chicken-utilities.runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Automatically copy built assembly to BepInEx plugins folder -->
  <Target Name="CopyToPlugins" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginsDir)" />
    <Message Importance="High" Text="Copied $(TargetFileName) to $(PluginsDir)" />
  </Target>

</Project>
